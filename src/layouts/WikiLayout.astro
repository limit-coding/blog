---
import WikiHeader from '../components/wiki/WikiHeader.astro';
import WikiFooter from '../components/wiki/WikiFooter.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import '../styles/wiki.css';

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
}

const { title, description = SITE_DESCRIPTION, pageClass = '' } = Astro.props;
const pageTitle = title ? `${title} — ${SITE_TITLE} 知识库` : `${SITE_TITLE} — 个人知识库`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
  </head>
  <body class={pageClass}>
    <a class="wiki-skip-link" href="#wiki-main">跳到正文</a>
    <WikiHeader />
    <main id="wiki-main">
      <slot />
    </main>
    <WikiFooter />
  </body>
</html>
