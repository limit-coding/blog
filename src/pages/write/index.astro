---
import WriterLayout from '../../layouts/WriterLayout.astro';
import { SECTIONS } from '../../consts';

const today = new Date().toLocaleDateString('en-CA');
---

<WriterLayout>
  <header class="writer-topbar" slot="header">
    <div class="writer-brand-group">
      <a class="writer-back" href="/" aria-label="返回知识库">←</a>
      <a class="writer-brand" href="/write/">
        <strong>learnpath</strong>
        <span>写作台</span>
      </a>
    </div>

    <div class="writer-save-state" id="save-state" role="status" aria-live="polite">
      <span aria-hidden="true"></span>
      <p>草稿保存在这台设备</p>
    </div>

    <div class="writer-view-switch" aria-label="编辑视图">
      <button type="button" data-view-mode="edit">编辑</button>
      <button type="button" data-view-mode="split">并排</button>
      <button type="button" data-view-mode="preview">预览</button>
    </div>

    <div class="writer-actions">
      <button class="writer-text-button" id="new-draft" type="button">新建</button>
      <button class="writer-text-button" id="copy-markdown" type="button">复制</button>
      <button class="writer-text-button writer-settings-button" id="toggle-settings" type="button" aria-expanded="false">
        设置
      </button>
      <button class="writer-primary-button" id="download-markdown" type="button">导出 .md</button>
    </div>
  </header>

  <div class="writer-app" id="writer-app" data-view="split" data-settings="closed">
    <div class="writer-workspace">
      <section class="writer-editor-pane" aria-label="Markdown 编辑器">
        <div class="writer-document-fields">
          <label class="sr-only" for="article-title">文章标题</label>
          <textarea
            id="article-title"
            class="writer-title-input"
            rows="1"
            placeholder="文章标题"
            spellcheck="true"
          ></textarea>
          <label class="sr-only" for="article-description">文章摘要</label>
          <textarea
            id="article-description"
            class="writer-description-input"
            rows="1"
            placeholder="用一句话说明这篇文章写了什么"
            spellcheck="true"
          ></textarea>
        </div>

        <div class="writer-toolbar" role="toolbar" aria-label="文章格式工具">
          <div class="writer-toolbar-group writer-smart-format-group">
            <button
              class="writer-smart-format-button"
              type="button"
              data-editor-action="auto-format"
              aria-label="自动识别段落和分标题"
              title="根据现有段落和标题格式自动排版"
            >
              ✦ 分标题
            </button>
          </div>
          <div class="writer-toolbar-group">
            <button type="button" data-editor-action="h2" aria-label="二级标题" title="二级标题">H2</button>
            <button type="button" data-editor-action="h3" aria-label="三级标题" title="三级标题">H3</button>
          </div>
          <div class="writer-toolbar-group">
            <button type="button" data-editor-action="bold" aria-label="粗体" title="粗体（⌘/Ctrl+B）"><strong>B</strong></button>
            <button type="button" data-editor-action="italic" aria-label="斜体" title="斜体（⌘/Ctrl+I）"><em>I</em></button>
            <button type="button" data-editor-action="link" aria-label="链接" title="插入链接">Link</button>
          </div>
          <div class="writer-toolbar-group">
            <button type="button" data-editor-action="quote" aria-label="引用" title="引用">“ ”</button>
            <button type="button" data-editor-action="code" aria-label="代码" title="代码">&lt;/&gt;</button>
            <button type="button" data-editor-action="math" aria-label="数学公式" title="数学公式">∑</button>
          </div>
          <div class="writer-toolbar-group">
            <button type="button" data-editor-action="ul" aria-label="无序列表" title="无序列表">• List</button>
            <button type="button" data-editor-action="ol" aria-label="有序列表" title="有序列表">1. List</button>
            <button type="button" data-editor-action="image" aria-label="图片" title="插入图片">Image</button>
            <button type="button" data-editor-action="divider" aria-label="分隔线" title="分隔线">—</button>
          </div>
        </div>

        <div class="writer-smart-notice" id="writer-smart-notice" role="status" aria-live="polite" hidden>
          <span id="writer-smart-notice-text"></span>
          <button id="undo-smart-format" type="button">撤销</button>
        </div>

        <label class="sr-only" for="markdown-editor">文章正文</label>
        <textarea
          id="markdown-editor"
          class="writer-markdown-editor"
          placeholder="从这里开始写。Markdown 会在右侧自动排版……"
          spellcheck="true"
        ></textarea>

        <footer class="writer-editor-footer">
          <span id="editor-position">第 1 行，第 1 列</span>
          <span>智能排版 · Markdown 存储</span>
        </footer>
      </section>

      <section class="writer-preview-pane" aria-label="文章预览">
        <div class="writer-preview-scroll" id="preview-scroll">
          <article class="writer-paper">
            <header class="writer-preview-header">
              <div class="writer-preview-kicker">
                <span id="preview-section">技术分享</span>
                <span aria-hidden="true">·</span>
                <time id="preview-date" datetime={today}></time>
              </div>
              <h1 id="preview-title"></h1>
              <p id="preview-description"></p>
              <div class="writer-preview-tags" id="preview-tags"></div>
            </header>
            <div class="writer-preview-content" id="preview-content"></div>
            <div class="writer-empty-preview" id="empty-preview">
              <span aria-hidden="true">Aa</span>
              <strong>开始写作，排版会自动出现</strong>
              <p>支持标题、引用、列表、代码块、表格、链接与 LaTeX 公式。</p>
            </div>
          </article>
        </div>
      </section>

      <aside class="writer-inspector" id="writer-inspector" aria-label="文章设置">
        <div class="writer-inspector-header">
          <strong>文章设置</strong>
          <button id="close-settings" type="button" aria-label="关闭文章设置">×</button>
        </div>

        <section class="writer-inspector-section">
          <h2>发布信息</h2>
          <label for="article-section">
            分类
            <select id="article-section">
              {SECTIONS.map((section) => (
                <option value={section.slug}>{section.label}</option>
              ))}
            </select>
          </label>
          <label for="article-slug">
            路径名
            <input id="article-slug" type="text" placeholder="article-slug" autocomplete="off" />
          </label>
          <label for="article-date">
            日期
            <input id="article-date" type="date" value={today} />
          </label>
          <label for="article-tags">
            标签
            <input id="article-tags" type="text" placeholder="AI, 写作, 方法" autocomplete="off" />
            <small>用逗号分隔</small>
          </label>
          <label for="article-cover">
            封面路径
            <input id="article-cover" type="text" placeholder="./cover.jpg" autocomplete="off" />
          </label>
          <label class="writer-checkbox" for="article-draft">
            <input id="article-draft" type="checkbox" checked />
            <span>
              <strong>保存为草稿</strong>
              <small>草稿不会出现在文章列表中</small>
            </span>
          </label>
        </section>

        <section class="writer-inspector-section writer-stats-section">
          <h2>文章统计</h2>
          <dl>
            <div><dt>字数</dt><dd id="stat-words">0</dd></div>
            <div><dt>阅读</dt><dd id="stat-reading">0 分钟</dd></div>
            <div><dt>段落</dt><dd id="stat-paragraphs">0</dd></div>
          </dl>
        </section>

        <section class="writer-inspector-section writer-outline-section">
          <h2>目录</h2>
          <nav id="writer-outline" aria-label="文章目录">
            <p>添加二级标题后，这里会生成目录。</p>
          </nav>
        </section>

        <section class="writer-path-card" aria-label="导出位置">
          <span>建议保存到</span>
          <code id="article-path">src/content/posts/tech/your-slug/index.md</code>
        </section>

        <section class="writer-paste-tip">
          <strong>直接粘贴长文即可</strong>
          <p>从 Word、备忘录或网页粘贴时，会保留标题、段落、列表和强调格式；纯文本会按编号与短标题自动分节。</p>
        </section>
      </aside>
    </div>
  </div>
</WriterLayout>

<script>
  import '../../scripts/writer';
</script>
